  <data key="d0">บริการฝากเลี้ยงต้นไม้</data>
  <data key="d1">method</data>
  <data key="d2">บริการดูแลต้นไม้สำหรับลูกค้าที่ไม่อยู่บ้าน โดยมีการคิดค่าบริการรายวันและมีข้อกำหนดในการจองและการดูแล</data>
  <data key="d3">kb-04_services-chunk-000</data>
  <data key="d4">04_services.md</data>
  <data key="d5">1791616366</data>
  <data key="d6"></data>
</node>
<node id="ร้าน">
  <data key="d0">ร้าน</data>
  <data key="d1">organization</data>
  <data key="d2">สถานที่ให้บริการเปลี่ยนกระถางและรับฝากเลี้ยงต้นไม้&lt;SEP&gt;ผู้ให้บริการที่ทำหน้าที่จัดส่งสินค้าและดำเนินการคืนเงิน&lt;SEP&gt;ผู้จำหน่ายต้นไม้และผู้กำหนดนโยบายการรับประกันสินค้า&lt;SEP&gt;ร้านขายต้นไม้ที่เปิดให้บริการทุกวันตั้งแต่เวลา 09:00 ถึง 19:00 น.</data>
  <data key="d3">kb-04_services-chunk-000&lt;SEP&gt;kb-05_shipping_payment-chunk-004&lt;SEP&gt;kb-06_policies_promotions-chunk-000&lt;SEP&gt;kb-08_faq-chunk-000</data>
