# ค่าของ RAG Server ตอน deploy (ไม่มีค่าลับ) — Dockerfile คัดลอกเป็น rag/.env
# ค่าลับ (LLM_API_KEY, GROQ_API_KEY) ตั้งใน Environment ของ Render แล้ว start.sh ส่งต่อให้
WORKING_DIR=./storage/lightrag_gemini
SUMMARY_LANGUAGE=Thai
LOG_LEVEL=INFO
LLM_BINDING=openai
LLM_MODEL=gemini-3.1-flash-lite
LLM_BINDING_HOST=https://generativelanguage.googleapis.com/v1beta/openai
LLM_TIMEOUT=120
TOP_K=20
CHUNK_TOP_K=8
ENABLE_LLM_CACHE=true
INDEX_FALLBACK_HOST=https://api.groq.com/openai/v1
INDEX_FALLBACK_MODEL=openai/gpt-oss-120b
EMBEDDING_PROVIDER=gemini
