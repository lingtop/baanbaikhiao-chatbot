# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง  (cp .env.example .env)
# ห้าม commit ไฟล์ .env ขึ้น git

# --- Chat LLM + Vision: Google AI Studio (https://aistudio.google.com/apikey) ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
VISION_MODEL=gemini-3.1-flash-lite
LLM_TEMPERATURE=0.2

# --- ตัวเทียบแบบ Local (LM Studio) ใช้แทน 3 บรรทัดบนเมื่อทดสอบ Cloud vs Local ---
# LLM_BASE_URL=http://127.0.0.1:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=google/gemma-4-e4b

# --- บริการในเครื่อง ---
RAG_BASE_URL=http://127.0.0.1:9621
RAG_MODE=mix
GUARD_BASE_URL=http://127.0.0.1:8001

# --- Guard Service ---
# Groq: https://console.groq.com/keys  (Prompt Guard 2 จับ prompt injection)
GROQ_API_KEY=
# ตัวจัดหมวดเนื้อหาอันตราย S1–S14 — หลัก Groq gpt-oss-20b, สำรอง Gemini (key เลือกตาม URL อัตโนมัติ)
SAFETY_BASE_URL=https://api.groq.com/openai/v1
SAFETY_MODEL=openai/gpt-oss-20b
SAFETY_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
SAFETY_FALLBACK_MODEL=gemini-3.1-flash-lite

# --- Chat LLM สำรอง เมื่อ Gemini ไม่ว่าง (503/429) — ข้อความเท่านั้น ---
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_MODEL=openai/gpt-oss-120b

# --- อื่น ๆ ---
APP_SESSION_SECRET=change-me-to-a-long-random-string
